{"data": [{"id": 2165, "slug": "overgeared", "title": "Overgeared", "alt_titles": ["\ud15c\ube68", "Temppal", "Grid's Item Peak", "Item Overgeared", "Over Power", "\u30c6\u30e0\u30d1\u30eb", "\u88c5\u5907\u4e4b\u795e", "\u0412\u043e \u0432\u0441\u0435\u043e\u0440\u0443\u0436\u0438\u0438", "\u0645\u062c\u0647\u0632 \u0628\u0627\u0644\u0643\u0627\u0645\u0644", "Tr\u00e2m Anh Th\u1ebf Phi\u1ec7t", "Sur\u00e9quip\u00e9", "Equipado Hasta Los Dientes", "O Super Equipado", "Terlalu Banyak Diperlengkapi"], "description": "Shin Youngwoo (a.k.a. Greed), an unlucky man in life and a low-level player in the popular VR game \u201cSatisfy,\u201d finds a powerful item that earns him a rare legendary class title: \u201cPagma\u2019s Successor.\u201d He\u2019s now a skilled blacksmith who can forge unique weapons and equip the game\u2019s most powerful gear. Grid resolves to use his new abilities to achieve fame and fortune, but as his very existence begins to stir up trouble in Satisfy, he realizes that life as a legend may be more than he bargained for\u2026.</p>", "cover": "https://cdn.asurascans.com/asura-images/covers/overgeared.905990.webp", "banner": "https://cdn.asurascans.com/asura-images/banners/overgeared.jpg", "status": "ongoing", "type": "manhwa", "author": "LEE Dong Wook/ PARK Saenal", "artist": "REDICE Studio", "popularity_rank": 1, "bookmark_count": 72601, "rating": 9.050491803278689, "chapter_count": 349, "last_chapter_at": "2026-11-14T03:57:55.951857Z", "created_at": "0001-01-01T00:00:00Z", "updated_at": "2026-11-15T07:02:30.74867Z", "public_url": "/comics/overgeared-f212c582", "source_url": "/s/2165", "genres": [{"id": 1, "name": "Action", "slug": "action"}, {"id": 4, "name": "Adventure", "slug": "adventure"}, {"id": 7, "name": "Comedy", "slug": "comedy"}, {"id": 16, "name": "Fantasy", "slug": "fantasy"}, {"id": 18, "name": "Game", "slug": "game"}], "latest_chapters": [{"id": 262950, "series_id": 0, "number": 348, "title": "The Enemy of My Enemy", "slug": "chapter-